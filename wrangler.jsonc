// Static site only: Cloudflare serves ./public as is, no Worker code.
// The custom domains need guide.kiwi to be an active zone on this Cloudflare account;
// on deploy, Cloudflare creates their DNS records and HTTPS certificates itself.
{
  "name": "kiwiguide",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "guide.kiwi", "custom_domain": true },
    { "pattern": "www.guide.kiwi", "custom_domain": true }
  ]
}
