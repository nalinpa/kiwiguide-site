// Static site in ./public, served as is. The Worker (src/worker.js) runs only for /go/* campaign links
// and logs clicks to the D1 database kiwiguide-clicks (see README, "Campaign links").
// Custom domains need their zone on this Cloudflare account; on deploy, Cloudflare
// creates the DNS records and HTTPS certificates itself.
{
  "name": "kiwiguide",
  "compatibility_date": "2026-10-01",
  // Branch previews: `npx wrangler versions upload` prints a private-ish preview URL on
  // workers.dev. The live site itself stays only on the custom domains below.
  "workers_dev": false,
  "preview_urls": true,
  "main": "src/worker.js",
  "assets": { "directory": "./public", "run_worker_first": ["/go/*", "/plan/apple"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "kiwiguide-clicks", "database_id": "8e919eff-fa80-4560-b848-0d70665a7eaf" }
  ],
  "routes": [
    { "pattern": "kiwiguide.app", "custom_domain": true },
    { "pattern": "www.kiwiguide.app", "custom_domain": true },
    // The first home: keep it so links already shared still work.
    { "pattern": "kiwiguide.blacksands.app", "custom_domain": true }
  ]
}
