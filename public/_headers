/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/img/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# iOS reads this to let Kiwi Guide save and fill passwords for kiwiguide.app. No file
# extension, so it needs its type set here.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# The password reset page calls Firebase's Identity Toolkit, so its policy adds connect-src.
# Cloudflare merges rules, so the site-wide policy is detached first (it must come after /*).
/reset/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src https://identitytoolkit.googleapis.com
  X-Robots-Tag: noindex

# The trip quiz shows place photos from the engine image host (img-src) and saves the trip through
# Firebase sign-up and the engine api (connect-src; 'self' keeps trips.json loading).
/plan/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; img-src 'self' https://api.blacksands.app; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; connect-src 'self' https://identitytoolkit.googleapis.com https://api.blacksands.app
